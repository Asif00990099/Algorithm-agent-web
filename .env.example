# ============================================================
# QuantPulse environment configuration
# Copy to .env and fill in what you have. Everything marked
# (optional) has a graceful fallback — the platform runs with
# ZERO paid keys using CoinGecko, Binance public, RSS, Reddit
# and Alternative.me.
# ============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security (REQUIRED in production) ---
# openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# openssl rand -base64 32  (encrypts stored exchange API keys)
ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database / cache (docker-compose overrides these) ---
DATABASE_URL=postgresql+asyncpg://quantpulse:quantpulse@localhost:5432/quantpulse
POSTGRES_PASSWORD=quantpulse
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- First admin account (seeded on first boot; change immediately) ---
FIRST_ADMIN_EMAIL=admin@quantpulse.local
FIRST_ADMIN_PASSWORD=ChangeMe!12345

# --- Market data keys (all optional, free tiers) ---
COINGECKO_API_KEY=            # free demo key: coingecko.com/api/pricing
ALPHA_VANTAGE_API_KEY=        # alphavantage.co/support/#api-key
FINNHUB_API_KEY=              # finnhub.io/register
FMP_API_KEY=                  # financialmodelingprep.com/developer
FRED_API_KEY=                 # fred.stlouisfed.org/docs/api/api_key.html

# --- News / social keys (all optional) ---
NEWSAPI_API_KEY=              # newsapi.org
MARKETAUX_API_KEY=            # marketaux.com
CRYPTOPANIC_API_KEY=          # cryptopanic.com/developers/api
TWITTER_BEARER_TOKEN=         # developer.x.com (enables X monitoring)

# --- AI provider (optional; 'none' = quant-only mode) ---
AI_PROVIDER=none              # openai | anthropic | local | none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1

# --- Live trading (keep disabled until strategies are validated) ---
LIVE_TRADING_ENABLED=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
DEMO_STARTING_BALANCE=100000
MAX_RISK_PER_TRADE_PCT=2.0

# --- Frontend build ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/stream
